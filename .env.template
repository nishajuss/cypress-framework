# Default values for local runs. Copy to `.env` to override locally; values set in the
# process environment (e.g. CI secrets) take precedence over both files.
#
# These are the public demo credentials published on https://www.saucedemo.com.
SAUCE_STANDARD_USER=standard_user
SAUCE_LOCKED_OUT_USER=locked_out_user
SAUCE_PROBLEM_USER=problem_user
SAUCE_PERFORMANCE_GLITCH_USER=performance_glitch_user
SAUCE_ERROR_USER=error_user
SAUCE_VISUAL_USER=visual_user
SAUCE_PASSWORD=secret_sauce

# Restful Booker API. Point API_BASE_URL at a local copy (`yarn booker:up`) with
# http://localhost:3001. These are the public default credentials from its documentation.
API_BASE_URL=https://restful-booker.herokuapp.com
BOOKER_USERNAME=admin
BOOKER_PASSWORD=password123

# Number of feature files to run concurrently with `yarn test:parallel`.
FEATURE_PARALLEL_WORKERS=3
